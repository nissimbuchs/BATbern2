# BATbern Platform - Environment Variables
# Copy this file to .env and configure for your environment

# ============================================================================
# Application Environment
# ============================================================================
SPRING_PROFILES_ACTIVE=local
LOG_LEVEL=DEBUG
APP_ENVIRONMENT=development

# Application Base URL (for email confirmation links)
# Development: http://localhost:3000
# Staging: https://www.batbern.ch
# Production: https://batbern.ch
APP_BASE_URL=http://localhost:3000

# JWT Secret for confirmation tokens (email verification, etc.)
# Generate a secure random secret for production
# Example: openssl rand -base64 32
JWT_SECRET=dev-secret-change-in-production-use-openssl-rand-base64-32

# ============================================================================
# Database Configuration (Local PostgreSQL)
# ============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=batbern
DB_USER=batbern_user
DB_PASSWORD=batbern-dev-password
DATABASE_URL=jdbc:postgresql://postgres:5432/batbern

# PostgreSQL Port (exposed to host)
POSTGRES_PORT=5432

# ============================================================================
# AWS Configuration
# ============================================================================
AWS_REGION=eu-central-1
AWS_PROFILE=batbern-staging

# AWS Cognito Configuration
COGNITO_USER_POOL_ID=eu-central-1_FtgfxgQRF
COGNITO_CLIENT_ID=1b53lci6qpqsmdn0u3e8s4knvv

# AWS S3 Configuration (User Management - Profile Pictures)
S3_CONTENT_BUCKET_NAME=batbern-content-staging
S3_PROFILE_PICTURES_BUCKET_NAME=batbern-profile-pictures-staging

# AWS CloudFront Configuration
CLOUDFRONT_DOMAIN=https://cdn.batbern.ch

# Enable/Disable Cognito Authentication (set to false for local dev without AWS)
ENABLE_COGNITO_AUTH=true

# ============================================================================
# API Gateway Configuration
# ============================================================================
API_GATEWAY_PORT=8080

# ============================================================================
# Agent Service: model adapter (agent runtime story 3)
# ============================================================================
# Without a key, agent-service in profile local answers with a canned local adapter
# (model local-scripted) and never reaches the model. Set a key only to try the real model
# locally; never commit one. Production reads it from Secrets Manager.
# AGENT_ANTHROPIC_API_KEY=none
# AGENT_ANTHROPIC_MODEL=claude-sonnet-5-5
#
# agent-service's caller secret at CUMS (agent runtime story 4): runs obtain their grant and mint
# their agent token at CUMS with it; CUMS checks it as AGENT_CALLERS_AGENT_SERVICE_SECRET. Leave it
# unset for native dev: make dev-native-up generates one value per instance and writes it under both
# names into .env.native.{instance}, reusing it on later starts. Set it here only to pick the value
# yourself (native dev and docker compose then pass it to both sides); never commit one. Blank here:
# runs are refused with CALLER_SECRET_MISSING; blank or different at CUMS: CALLER_SECRET_INVALID
# (both GRANT_REFUSED, handed to the organizers). Production reads it
# from Secrets Manager. CUMS and the gateway come from COMPANY_USER_MANAGEMENT_SERVICE_URL and
# AGENT_GATEWAY_URL (default API_BASE_URL).
# AGENT_CUMS_CALLER_SECRET=

# ============================================================================
# Service Ports (exposed to host) for Docker Compose (docker-compose.yml)
# ============================================================================
# Native dev (make dev-native-up) ignores these: scripts/dev/start-all-native.sh derives
# every port from BASE_PORT (default 8000: gateway 8000, services 8001-8004,
# frontend 8100) and writes them to .env.native.{instance}.
# API Gateway: 8080
# Company-User Management Service: 8081
# Event Management Service: 8082
# Agent Service: 8083
# Partner Coordination Service: 8084

# ============================================================================
# Development Notes
# ============================================================================
# For local development with PostgreSQL:
# - Set DB_HOST=postgres (Docker network) or DB_HOST=localhost (from host)
# - Run: docker-compose up postgres to start only PostgreSQL
# - Run: docker-compose up to start all services
#
# For AWS RDS development:
# - Set DB_HOST to your RDS endpoint
# - Ensure AWS credentials are configured
# - Run services individually or use docker-compose
