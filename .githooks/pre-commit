#!/bin/bash

# BATbern Platform - Pre-commit Hook
# Enforces TDD practices by running tests for changed files

set -e

echo "🧪 Running pre-commit tests for changed files..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    echo "No files staged for commit"
    exit 0
fi

# Check for TypeScript/JavaScript changes
TS_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx)$' || true)
JAVA_FILES=$(echo "$STAGED_FILES" | grep -E '\.java$' || true)

# Track if any tests failed
TESTS_FAILED=0

# Run frontend checks if TypeScript/JavaScript files changed
if [ -n "$TS_FILES" ]; then
    echo -e "${YELLOW}📦 Frontend files changed, running checks...${NC}"

    # Use lint-staged for efficient frontend checks
    if [ -d "web-frontend" ] && [ -f "web-frontend/package.json" ]; then
        cd web-frontend

        # Filter for frontend files only and strip web-frontend/ prefix
        FRONTEND_FILES=$(echo "$STAGED_FILES" | grep '^web-frontend/' | sed 's|^web-frontend/||')

        if [ -n "$FRONTEND_FILES" ]; then
            # Run ESLint on changed frontend files (exclude config and env files)
            echo "  Running ESLint..."
            LINT_FILES=$(echo "$FRONTEND_FILES" | grep -v -E '\.(eslintrc|prettierignore)' | grep -v '\.env' || true)
            if [ -n "$LINT_FILES" ]; then
                echo "$LINT_FILES" | xargs npx eslint --max-warnings 0 --no-warn-ignored || TESTS_FAILED=1
            fi

            # Run Prettier check on changed frontend files (exclude config and env files)
            echo "  Running Prettier..."
            PRETTIER_FILES=$(echo "$FRONTEND_FILES" | grep -v -E '\.(eslintrc|prettierignore|eslintignore)' | grep -v '\.env' || true)
            if [ -n "$PRETTIER_FILES" ]; then
                echo "$PRETTIER_FILES" | xargs npx prettier --check || TESTS_FAILED=1
            fi
        fi
        cd ..
    elif [ -f "package.json" ]; then
        # Fallback for non-monorepo structure
        npx eslint $TS_FILES --max-warnings 0 --no-warn-ignored || TESTS_FAILED=1
        npx prettier --check $TS_FILES || TESTS_FAILED=1
    fi
fi

# ── Generated API types must match the specs (#902) ──────────────────────────────
#
# `check:api-types` regenerates every OpenAPI-derived type file and fails if the result
# differs from what is committed. Until now it ran ONLY in CI ("Verify API types are
# up-to-date" in build-frontend), so this class of break was invisible locally — and on this
# repo a push to a PR branch IS a production deploy, so the cost of finding out in CI is a
# wasted deploy, not just a wasted pipeline run.
#
# It bites even when no spec changed: every `generate:api-types:*` script pipes
# openapi-typescript output through `prettier --write`, so the committed files carry whatever
# formatting the pinned prettier produced. #880 bumped prettier 3.8.3 → 3.9.6, which collapsed
# short unions onto one line, and CI failed after lint, tsc, the production build and 5470
# tests had all passed locally. None of those can catch it.
#
# Why pre-commit and not pre-push (which is what #902 suggested): pre-push here runs the FULL
# Java suite including Testcontainers integration tests, which is too heavy for smaller dev
# machines — it is routinely bypassed with `--no-verify`, so a check placed there would simply
# never run. pre-commit is lightweight (eslint/prettier/checkstyle) and actually executes.
#
# Gated so it costs nothing on an ordinary commit. The package.json/lock triggers are what
# catch the prettier-bump case, which is NOT a spec edit.
API_TYPE_TRIGGERS=$(echo "$STAGED_FILES" | grep -E \
  '^docs/api/|^web-frontend/package(-lock)?\.json$|^web-frontend/src/types/generated/' || true)

if [ -n "$API_TYPE_TRIGGERS" ]; then
    echo -e "${YELLOW}🔗 API specs / frontend deps changed, verifying generated types...${NC}"
    if [ -d "web-frontend" ]; then
        cd web-frontend
        # Regenerates in place, then diffs against what is committed. If types are current
        # this is a no-op; if not, it fails AND leaves the corrected files in the working
        # tree, so the fix is `git add src/types/generated/`.
        npm run check:api-types || TESTS_FAILED=1
        cd ..
    fi
fi

# Run backend checks if Java files changed
if [ -n "$JAVA_FILES" ]; then
    echo -e "${YELLOW}☕ Java files changed, running checks...${NC}"

    # Run Checkstyle for changed files
    if [ -f "gradlew" ]; then
        echo "  Running Checkstyle..."
        ./gradlew checkstyleMain checkstyleTest || TESTS_FAILED=1
    fi
fi


# Final check
if [ $TESTS_FAILED -ne 0 ]; then
    echo -e "${RED}❌ Pre-commit checks failed!${NC}"
    echo -e "${RED}Please fix the issues above before committing.${NC}"
    echo ""
    echo "To bypass this check (NOT recommended), use:"
    echo "  git commit --no-verify"
    exit 1
fi

echo -e "${GREEN}✅ All pre-commit checks passed!${NC}"
exit 0