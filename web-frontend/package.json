    "@types/papaparse": "^5.5.2",
    "aws-amplify": "^6.15.8",
    "axios": "^1.19.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
