{
  "name": "@batbern/web-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "prerender": "node scripts/prerender.mjs",
    "build:prerender": "npm run build && npm run prerender",
    "preview": "vite preview",
    "preview:prerender": "node scripts/preview-prerender.mjs",
    "test": "mkdir -p test-results/assets && vitest run",
    "test:unit": "mkdir -p test-results/assets && vitest run",
    "test:watch": "mkdir -p test-results/assets && vitest",
    "test:ui": "mkdir -p test-results/assets && vitest --ui",
    "test:coverage": "mkdir -p test-results/assets && vitest run --coverage",
    "test:coverage:check": "mkdir -p test-results/assets && vitest run --coverage && echo 'Coverage threshold check passed'",
    "test:coverage:ci": "mkdir -p test-results/assets && vitest run --coverage || true",
    "test:run": "mkdir -p test-results/assets && vitest run",
    "test:e2e": "playwright test",
    "test:e2e:staging": "TEST_ENV=staging playwright test",
    "test:e2e:production": "TEST_ENV=production playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:docs": "INCLUDE_DOCS_TESTS=true playwright test --project=documentation-screenshots",
    "test:e2e:docs:ui": "INCLUDE_DOCS_TESTS=true playwright test --project=documentation-screenshots --ui",
    "test:e2e:screencast": "INCLUDE_DOCS_TESTS=true playwright test --project=screencast-training",
    "test:e2e:screencast:headed": "INCLUDE_DOCS_TESTS=true playwright test --project=screencast-training --headed",
    "screencast:narration": "node e2e/workflows/documentation/screencast/scripts/generate-narration-audio.mjs",
    "screencast:assemble": "node e2e/workflows/documentation/screencast/scripts/assemble-narration.mjs",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "lint:ci": "eslint src --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "security:scan": "trivy fs --scanners vuln,secret,misconfig --format sarif --output ../security-reports/web-frontend-trivy.sarif --severity UNKNOWN,LOW,MEDIUM,HIGH,CRITICAL .",
    "generate:api-types": "npm run generate:api-types:companies && npm run generate:api-types:users && npm run generate:api-types:events && npm run generate:api-types:speakers && npm run generate:api-types:topics && npm run generate:api-types:partners && npm run generate:api-types:partner-meetings",
    "check:api-types": "npm run generate:api-types && git diff --exit-code src/types/generated/ || (echo '\n\u274c ERROR: Generated API types are out of date!\n\nRun the following command to update them:\n  cd web-frontend && npm run generate:api-types\n\nThen commit the updated files.\n' && exit 1)",
    "generate:api-types:companies": "openapi-typescript ../docs/api/companies-api.openapi.yml -o src/types/generated/company-api.types.ts && prettier --write src/types/generated/company-api.types.ts",
    "generate:api-types:users": "openapi-typescript ../docs/api/users-api.openapi.yml -o src/types/generated/user-api.types.ts && prettier --write src/types/generated/user-api.types.ts",
    "generate:api-types:events": "npm run generate:api-types:events-core && npm run generate:api-types:event-sessions && npm run generate:api-types:event-speakers && npm run generate:api-types:event-registrations && npm run generate:api-types:event-newsletter && npm run generate:api-types:event-media && npm run generate:api-types:event-ai && npm run generate:api-types:event-app-settings && npm run generate:api-types:event-analytics && npm run generate:api-types:event-watch && npm run generate:api-types:event-tasks",
    "generate:api-types:events-core": "openapi-typescript ../docs/api/events-core-api.openapi.yml -o src/types/generated/events-core-api.types.ts && prettier --write src/types/generated/events-core-api.types.ts",
    "generate:api-types:event-sessions": "openapi-typescript ../docs/api/event-sessions-api.openapi.yml -o src/types/generated/event-sessions-api.types.ts && prettier --write src/types/generated/event-sessions-api.types.ts",
    "generate:api-types:event-speakers": "openapi-typescript ../docs/api/event-speakers-api.openapi.yml -o src/types/generated/event-speakers-api.types.ts && prettier --write src/types/generated/event-speakers-api.types.ts",
    "generate:api-types:event-registrations": "openapi-typescript ../docs/api/event-registrations-api.openapi.yml -o src/types/generated/event-registrations-api.types.ts && prettier --write src/types/generated/event-registrations-api.types.ts",
    "generate:api-types:event-newsletter": "openapi-typescript ../docs/api/event-newsletter-api.openapi.yml -o src/types/generated/event-newsletter-api.types.ts && prettier --write src/types/generated/event-newsletter-api.types.ts",
    "generate:api-types:event-media": "openapi-typescript ../docs/api/event-media-api.openapi.yml -o src/types/generated/event-media-api.types.ts && prettier --write src/types/generated/event-media-api.types.ts",
    "generate:api-types:event-ai": "openapi-typescript ../docs/api/event-ai-api.openapi.yml -o src/types/generated/event-ai-api.types.ts && prettier --write src/types/generated/event-ai-api.types.ts",
    "generate:api-types:event-app-settings": "openapi-typescript ../docs/api/event-app-settings-api.openapi.yml -o src/types/generated/event-app-settings-api.types.ts && prettier --write src/types/generated/event-app-settings-api.types.ts",
    "generate:api-types:event-analytics": "openapi-typescript ../docs/api/event-analytics-api.openapi.yml -o src/types/generated/event-analytics-api.types.ts && prettier --write src/types/generated/event-analytics-api.types.ts",
    "generate:api-types:event-watch": "openapi-typescript ../docs/api/event-watch-api.openapi.yml -o src/types/generated/event-watch-api.types.ts && prettier --write src/types/generated/event-watch-api.types.ts",
    "generate:api-types:event-tasks": "openapi-typescript ../docs/api/event-tasks-api.openapi.yml -o src/types/generated/event-tasks-api.types.ts && prettier --write src/types/generated/event-tasks-api.types.ts",
    "generate:api-types:speakers": "openapi-typescript ../docs/api/speakers-api.openapi.yml -o src/types/generated/speakers-api.types.ts && prettier --write src/types/generated/speakers-api.types.ts",
    "generate:api-types:topics": "openapi-typescript ../docs/api/topics-api.openapi.yml -o src/types/generated/topics-api.types.ts && prettier --write src/types/generated/topics-api.types.ts",
    "generate:api-types:partners": "openapi-typescript ../docs/api/partners-api.openapi.yml -o src/types/generated/partner-api.types.ts && prettier --write src/types/generated/partner-api.types.ts",
    "generate:api-types:partner-meetings": "openapi-typescript ../docs/api/partner-meetings-api.openapi.yml -o src/types/generated/partner-meetings-api.types.ts && prettier --write src/types/generated/partner-meetings-api.types.ts"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.13.1",
