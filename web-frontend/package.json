    "ics": "^3.8.1",
    "lucide-react": "^1.35.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^14.3.8",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.83.0",
    "react-i18next": "^16.1.0",
    "react-intersection-observer": "^10.0.0",
