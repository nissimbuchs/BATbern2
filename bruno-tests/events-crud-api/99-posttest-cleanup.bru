meta {
  name: Posttest cleanup — final sweep of BRUNO-TEST-* events
  type: http
  seq: 99
}

post {
  url: {{baseUrl}}/admin/test-fixtures/ems/cleanup
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: {{$guid}}
  Content-Type: application/json
}

body:json {
  {
    "entityType": "events",
    "prefix": "BRUNO-TEST-"
  }
}

tests {
  test("posttest cleanup accepted (200) or gracefully missing (404)", function() {
    expect([200, 204, 404]).to.include(res.getStatus());
  });

  test("if 200, deletion counts are reported", function() {
    if (res.getStatus() === 200) {
      const body = res.getBody();
      expect(body.deletionCounts).to.be.an("object");
      expect(body.deletionCounts.events).to.be.a("number");
    }
  });
}

docs {
  Audit-pass addition (PR 2 split, plan §B3): unconditional posttest cleanup.
  Runs AFTER every other test in this collection regardless of pass/fail —
  29-delete-event should already have removed the BRUNO-TEST-* event created
  by 03-create-event, but if any test between 03 and 29 crashed without
  cleanup this sweep catches the leftover plus all its cascade dependents.

  Status assertion is `oneOf([200, 204, 404])` so a missing cleanup endpoint
  never fails the collection.
}
