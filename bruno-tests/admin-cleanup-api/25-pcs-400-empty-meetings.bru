meta {
  name: PCS cleanup — meetings empty allowlist rejected
  type: http
  seq: 25
}

post {
  url: {{baseUrl}}/admin/test-fixtures/pcs/cleanup
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: {{$guid}}
  Content-Type: application/json
}

body:json {
  {
    "entityType": "meetings",
    "meetingIds": []
  }
}

assert {
  res.status: eq 400
}

tests {
  test("returns 400 when the meetings allowlist is empty", function() {
    expect(res.getStatus()).to.equal(400);
  });
}

docs {
  PR 13: the meetings entityType requires a non-empty id allowlist — an empty
  list is rejected at the service layer (ResponseStatusException 400) so a caller
  can never issue an unbounded meetings DELETE. Mirrors the prefix-validation 400
  cases (03/13/23) for the prefix-based entity types.
}
