meta {
  name: Posttest cleanup — sweep the users the import created (synthetic test domains)
  type: http
  seq: 100
}

post {
  url: {{baseUrl}}/admin/test-fixtures/cums/cleanup
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: {{$guid}}
  Content-Type: application/json
}

body:json {
  {
    "entityType": "users_by_email",
    "prefix": "@e2e.batbern.invalid"
  }
}

tests {
  test("posttest cleanup accepted (200) or gracefully missing (404)", function() {
    expect([200, 204, 404]).to.include(res.getStatus());
  });
}

docs {
  Story 4.10c: 01 creates a user under @e2e.batbern.invalid; 99c sweeps the
  @batbern-test.ch one.
}
