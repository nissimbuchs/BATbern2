    "participantEmail": "{{participantsImportEmail}}",
    "firstName": "Bruno",
    "lastName": "Importtest",
    "registrations": [{ "eventCode": "{{participantsEventCode}}", "status": "ATTENDED" }]
  }
}

tests {
  test("404 or 405, no handler", function() {
    expect([404, 405]).to.include(res.getStatus());
  });
}

