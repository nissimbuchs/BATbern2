meta {
  name: Single mode — an already-active registrant answers 409
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/events/{{participantsEventCode}}/participants
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "username": "{{testSpeakerUsername}}",
    "notify": false
  }
}

assert {
  res.status: eq 409
}

docs {
  Story 4.10c: unchanged single-add rule, an active registration is not added twice.
}
