meta {
  name: Confirm the event-photo upload with its event
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/uploads/event-photo/{{photoUploadId}}/confirm
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: {{$guid}}
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "target": { "eventCode": "{{photoEventCode}}" }
  }
}

assert {
  res.status: eq 200
  res.body.status: eq ASSOCIATED
  res.body.purpose: eq event-photo
}

tests {
  test("should store the photo under the event, keyed by the upload", function() {
    const key = "events/" + bru.getVar("photoEventCode") + "/photos/" + bru.getVar("photoUploadId") + ".jpg";
    expect(res.getBody().fileUrl).to.include(key);
  });
}

docs {
  The confirm with the target creates the photo in the event's gallery (event_photos row, id =
  uploadId). Another event than the reserved one would be 404 (EventPhotoUploadIntegrationTest).
}
