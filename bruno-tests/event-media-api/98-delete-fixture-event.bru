meta {
  name: Cleanup — delete the photo fixture event
  type: http
  seq: 98
}

delete {
  url: {{baseUrl}}/events/{{photoEventCode}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("fixture event deleted or left to the number sweep", function() {
    expect([204, 404, 409]).to.include(res.getStatus());
  });
}

docs {
  Deleting the event also removes any photo row left by a failed run (cascade). 99 sweeps the
  reserved number range regardless.
}
