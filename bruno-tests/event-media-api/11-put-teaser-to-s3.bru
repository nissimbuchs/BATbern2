meta {
  name: PUT the teaser image to the presigned URL
  type: http
  seq: 11
}

put {
  url: {{teaserUploadUrl}}
  body: text
  auth: none
}

headers {
  Content-Type: image/png
}

body:text {
  PNG!
}

assert {
  res.status: eq 200
}

docs {
  Straight to S3 (MinIO locally), no Authorization header: the presigned URL is the credential.
}
