meta {
  name: Reserve an event-photo upload for the fixture event
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/uploads/event-photo
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: {{$guid}}
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "fileName": "bruno-photo-{{photoTimestamp}}.jpg",
    "contentType": "image/jpeg",
    "size": 4,
    "target": { "eventCode": "{{photoEventCode}}" }
  }
}

assert {
  res.status: eq 201
  res.body.uploadId: isDefined
  res.body.uploadUrl: isDefined
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("photoUploadId", res.getBody().uploadId);
    bru.setVar("photoUploadUrl", res.getBody().uploadUrl);
  }
}

tests {
  test("should name the signed Content-Type", function() {
    expect(res.getBody().requiredHeaders['Content-Type']).to.equal('image/jpeg');
  });
}

docs {
  Story 17.11b: purpose event-photo is owned by event-management; the gateway routes
  /uploads/event-photo there. The target eventCode is required and bound to the upload: the
  confirm must name the same event. The declared size (4 bytes) is signed into the URL.
}
