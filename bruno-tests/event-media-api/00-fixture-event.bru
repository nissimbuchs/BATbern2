meta {
  name: Fixture — create the event the photo upload tests act on
  type: http
  seq: 0
}

post {
  url: {{baseUrl}}/events
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

script:pre-request {
  const now = Date.now();
  const eventNumber = 10000 + Math.floor(Math.random() * 90000); // reserved test range, swept by 99
  const dayMs = 24 * 60 * 60 * 1000;
  bru.setVar("photoTimestamp", now);
  bru.setVar("photoEventNumber", eventNumber);
  bru.setVar("photoEventDate", new Date(now + 60 * dayMs).toISOString());
  bru.setVar("photoRegDeadline", new Date(now + 53 * dayMs).toISOString());
}

body:json {
  {
    "title": "BRUNO-TEST-EVENT-PHOTO {{photoTimestamp}}",
    "eventNumber": {{photoEventNumber}},
    "date": "{{photoEventDate}}",
    "registrationDeadline": "{{photoRegDeadline}}",
    "venueName": "Bruno Test Venue",
    "venueAddress": "Test Address 7, 3000 Bern",
    "venueCapacity": 100,
    "organizerUsername": "{{organizerUsername}}",
    "description": "Parent event for the event photo upload tests (Story 17.11b)",
    "eventType": "EVENING"
  }
}

assert {
  res.status: eq 201
  res.body.eventCode: isDefined
}

tests {
  test("photoEventCode set for the collection", function() {
    bru.setVar("photoEventCode", res.getBody().eventCode);
  });
}

docs {
  Story 17.11b: dev-only collection (dev_only_collections in scripts/ci/run-bruno-tests.sh). It
  uploads a photo to its own fixture event through the upload contract, purpose event-photo, and
  deletes the photo (08) and the event (98/99) again. Story 17.11c adds a teaser image, purpose
  teaser-image (10-15), deleted in 15.
}
