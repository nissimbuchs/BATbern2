meta {
  name: Cleanup — delete the publishing fixture event
  type: http
  seq: 98
}

delete {
  url: {{baseUrl}}/events/{{publishingEventCode}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("fixture event deleted or left to the number sweep", function() {
    expect([204, 404, 409]).to.include(res.getStatus());
  });
}

docs {
  Story 4.9b: 409 is possible when the event's state forbids DELETE; 99 sweeps
  the reserved number range regardless.
}
