meta {
  name: Fixture — create the event the publishing tests act on
  type: http
  seq: 0
}

post {
  url: {{baseUrl}}/events
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

script:pre-request {
  const now = Date.now();
  const eventNumber = 10000 + Math.floor(Math.random() * 90000); // reserved test range, swept by 99
  const dayMs = 24 * 60 * 60 * 1000;
  bru.setVar("publishingTimestamp", now);
  bru.setVar("publishingEventNumber", eventNumber);
  bru.setVar("publishingEventDate", new Date(now + 60 * dayMs).toISOString());
  bru.setVar("publishingRegDeadline", new Date(now + 53 * dayMs).toISOString());
}

body:json {
  {
    "title": "Bruno Publishing Fixture Event {{publishingTimestamp}}",
    "eventNumber": {{publishingEventNumber}},
    "date": "{{publishingEventDate}}",
    "registrationDeadline": "{{publishingRegDeadline}}",
    "venueName": "Publishing Test Venue",
    "venueAddress": "Test Address 5, 3000 Bern",
    "venueCapacity": 100,
    "organizerUsername": "{{organizerUsername}}",
    "description": "Parent event for event-publishing-api tests (Story 4.9b)",
    "eventType": "EVENING"
  }
}

assert {
  res.status: eq 201
  res.body.eventCode: isDefined
}

tests {
  test("publishingEventCode set for the collection", function() {
    bru.setVar("publishingEventCode", res.getBody().eventCode);
  });
}

docs {
  Story 4.9b: dev-only collection (dev_only_collections in
  scripts/ci/run-bruno-tests.sh). Publishing acts on the public website (CDN
  invalidation, EventPublishedEvent, organizer notices), so these files must
  never run against staging, which is production. Event number in the
  reserved test range [10000, 99999]; 99 sweeps it.
}
