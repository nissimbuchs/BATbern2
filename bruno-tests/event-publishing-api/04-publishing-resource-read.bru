meta {
  name: Publishing resource — GET returns the stored schedule
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/events/{{publishingEventCode}}/publishing
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

assert {
  res.status: eq 200
}

tests {
  test("the schedule PATCHed by 03 persisted", function() {
    const body = res.getBody();
    expect(body.phase2DaysBeforeEvent).to.equal(21);
    expect(body.phase3DaysBeforeEvent).to.equal(10);
  });
}

docs {
  Story 4.9b: read-back of 03.
}
