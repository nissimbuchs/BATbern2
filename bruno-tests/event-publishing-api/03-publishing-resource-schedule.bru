meta {
  name: Publishing resource — PATCH the auto-publish schedule
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/events/{{publishingEventCode}}/publishing
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "phase2DaysBeforeEvent": 21,
    "phase3DaysBeforeEvent": 10
  }
}

assert {
  res.status: eq 200
}

tests {
  test("only the sent fields changed, the rest keeps its default", function() {
    const body = res.getBody();
    expect(body.phase2Enabled).to.equal(true);
    expect(body.phase2DaysBeforeEvent).to.equal(21);
    expect(body.phase3Enabled).to.equal(true);
    expect(body.phase3DaysBeforeEvent).to.equal(10);
    expect(body.phase3TriggerDate).to.be.a("string");
  });

  test("the status is part of the same resource", function() {
    const body = res.getBody();
    expect(body.publishedPhases).to.include("agenda");
    expect(body.currentPhase).to.equal("agenda");
  });
}

docs {
  Story 4.9b: status and schedule are one resource,
  GET/PATCH /events/{eventCode}/publishing (replaces POST/GET
  /publish/schedule and GET /publish/status). 04 reads it back.
}
