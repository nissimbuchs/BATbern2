meta {
  name: Merge Preview Same Company
  type: http
  seq: 14.5
}

get {
  url: {{baseUrl}}/companies/{{testCompanyName}}/merge-preview?source={{testCompanyName}}
  body: none
  auth: bearer
}

params:query {
  source: {{testCompanyName}}
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: test-{{timestamp}}
  Accept: application/json
}

script:pre-request {
  const testCompanyName = bru.getVar("testCompanyName");
  if (!testCompanyName) {
    throw new Error("testCompanyName not set. Run 01-create-company first.");
  }
}

tests {
  test("should preview without merging", function() {
    expect(res.status).to.equal(200);
  });

  test("the same company cannot be merged into itself", function() {
    expect(res.body.canMerge).to.equal(false);
    expect(res.body.reasons).to.include("SAME_COMPANY");
    expect(res.body.target.name).to.equal(bru.getVar("testCompanyName"));
    expect(res.body.source.name).to.equal(bru.getVar("testCompanyName"));
  });

  test("moves, blockers and fills are empty", function() {
    expect(Object.keys(res.body.moves)).to.have.length(0);
    expect(res.body.blockers).to.have.length(0);
    expect(res.body.fills).to.have.length(0);
  });
}

docs {
  Issue 1251, stories 4 and 5: GET /companies/{name}/merge-preview with the collection's own company as both
  target and source. CUMS answers SAME_COMPANY without asking any holder of the company-references
  contract, so this is read-only on every environment. No Bruno request merges (it would write).
}
