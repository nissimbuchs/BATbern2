meta {
  name: Disable Speaker Reminders (Story 6.5 AC6)
  type: http
  seq: 60
}

patch {
  url: {{baseUrl}}/events/{{createdEventCode}}/speakers/{{createdSpeakerPoolId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "remindersDisabled": true
  }
}

assert {
  res.status: eq 200
  res.body.remindersDisabled: eq true
}

tests {
  test("should return 200 status - Story 6.5 AC6", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("should confirm reminders disabled - Story 6.5 AC6", function() {
    const body = res.getBody();
    expect(body.remindersDisabled).to.be.true;
    expect(body.id).to.equal(bru.getVar("createdSpeakerPoolId"));
  });
}

docs {
  Story 4.10: the reminders switch is a field of the entry PATCH,
  PATCH /events/{eventCode}/speakers/{speakerId} with remindersDisabled (ADR-013 section 1:
  no per-attribute endpoint). The former PATCH /speaker-pool/{speakerPoolId}/reminders is gone.
  The answer is the whole pool entry, so the stored switch is read back from it.
}
