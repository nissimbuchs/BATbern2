meta {
  name: Cleanup — delete speaker pool fixture event
  type: http
  seq: 98
}

delete {
  url: {{baseUrl}}/events/{{createdEventCode}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("fixture event deleted (cascades speaker_pool + workflow/reminder history)", function() {
    expect([204, 404]).to.include(res.getStatus());
  });

  test("clear createdEventCode for next run", function() {
    bru.setVar("createdEventCode", null);
  });
}

docs {
  PR 2 split (paired with 00b-fixture-event.bru): DELETE cascade removes
  speaker_pool + speaker_status_history + speaker_reminder_log +
  speaker_outreach_history + speaker_arrivals + speaker_slot_preferences.
  Accepts 204 or 404 (already deleted).
}
