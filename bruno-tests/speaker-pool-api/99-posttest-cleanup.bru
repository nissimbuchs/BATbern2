meta {
  name: Posttest cleanup — final sweep of BRUNO-TEST-* events (cascades speaker_pool)
  type: http
  seq: 99
}

post {
  url: {{baseUrl}}/admin/test-fixtures/ems/cleanup
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: {{$guid}}
  Content-Type: application/json
}

body:json {
  {
    "entityType": "events",
    "prefix": "BRUNO-TEST-"
  }
}

tests {
  test("posttest cleanup accepted (200) or gracefully missing (404)", function() {
    expect([200, 204, 404]).to.include(res.getStatus());
  });

  test("if 200, deletion counts are reported", function() {
    if (res.getStatus() === 200) {
      const body = res.getBody();
      expect(body.deletionCounts).to.be.an("object");
      expect(body.deletionCounts.events).to.be.a("number");
    }
  });
}

docs {
  PR 2 split (plan §B3): final sweep of BRUNO-TEST-* events.

  PR 11 closed the cross-service cleanup gap: tests 38 + 45–47 now use
  firstName=Bruno, lastName=Test (yielding `bruno.test` bare or `bruno.test.N`
  suffixed via SlugGenerationService collision resolution), and the CUMS
  USERS regex was widened to accept the bare prefix (LIKE `bruno.test%`).
  CUMS sweep runs from 00a-/99a-pretest/posttest-cleanup-users.bru.
}
