meta {
  name: Venue coordination — preview rendering
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/events/BATbern59/venue-coordination/preview
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerAuthToken}}
}

script:pre-request {
  // READ-ONLY: observe whether the venue.coordination.config singleton is set, never write it.
  // Missing or failed reads are treated as "not configured", which the tests then pin to 412.
  let configured = false;
  try {
    const res = await bru.sendRequest({
      method: "GET",
      url: bru.getEnvVar("baseUrl") + "/admin/settings/venue.coordination.config",
      headers: { "Authorization": "Bearer " + bru.getEnvVar("organizerAuthToken") }
    });
    const value = res && res.data ? res.data.value : null;
    configured = typeof value === "string" && value.trim() !== "";
  } catch (e) {
    configured = false;
  }
  bru.setVar("venueConfigConfigured", configured);
}

body:json {
  {
    "templateKey": "venue-timetable",
    "recipients": ["VENUE"],
    "locale": "de"
  }
}

tests {
  test("status matches the observed config state", function() {
    if (bru.getVar("venueConfigConfigured")) {
      // 404 only when BATbern59 does not exist in this environment (as in the sibling files).
      expect([200, 404]).to.include(res.getStatus());
    } else {
      expect(res.getStatus()).to.equal(412);
    }
  });

  test("envelope contains subject, htmlBody, toEmail, replyToEmail when 200", function() {
    if (res.getStatus() === 200) {
      const body = res.getBody();
      expect(body.subject).to.be.a("string").and.not.equal("");
      expect(body.htmlBody).to.be.a("string").and.not.equal("");
      expect(body.toEmail).to.be.a("string").and.not.equal("");
      expect(body.ccEmails).to.be.an("array");
      expect(body.replyToEmail).to.be.a("string").and.not.equal("");
    }
  });

  test("subject placeholder is rendered when 200", function() {
    if (res.getStatus() === 200) {
      expect(res.getBody().subject).to.not.include("{{eventDate}}");
    }
  });
}

docs {
  Contract test for POST /events/{code}/venue-coordination/preview. Preview renders only:
  readOnly transaction, no SES send.

  Read-only by design (#1135). The previous version seeded venue.coordination.config with
  PUT /admin/settings/... in its pre-request. That singleton is the real venue and catering
  contact set used by the organizer's venue mails, and Bruno runs against staging, which is
  production, so the seed would have overwritten it with test contacts. It never ran in CI
  only because bruno-tests/events/ was missing from run-bruno-tests.sh.

  The pre-request now only GETs the setting. The tests are strict in both states rather than
  tolerant: configured means 200 (or 404 if BATbern59 is absent), unconfigured means exactly
  412. A misconfigured environment therefore still asserts a specific status.

  /send is NOT covered here — sending real SES traffic from Bruno would violate the
  no-real-comms-in-tests rule (staging IS production). The send path is exercised by
  VenueCoordinationControllerIntegrationTest with a mocked EmailService.

  Bruno parser rule: comments belong in this docs { } block, not as free-floating `#`
  lines (those silently skip the file — see CLAUDE.md).
}
