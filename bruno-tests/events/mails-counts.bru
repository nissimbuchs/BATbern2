meta {
  name: Mail page — counts for handled automatically (organizer)
  type: http
  seq: 22
}

get {
  url: {{baseUrl}}/events/BATbern59/mails/counts
  body: none
  auth: bearer
}

auth:bearer {
  token: {{organizerAuthToken}}
}

tests {
  test("returns 200 (404 where BATbern59 is not seeded)", function() {
    expect([200, 404]).to.include(res.getStatus());
  });

  test("failedDeliveries is a non-negative number", function() {
    if (res.getStatus() === 200) {
      expect(res.getBody().failedDeliveries).to.be.at.least(0);
    }
  });

  test("Story 16.2a: the automatic inbound counts are present", function() {
    if (res.getStatus() === 200) {
      const body = res.getBody();
      ["outOfOffice", "bounces", "calendarAccepts", "calendarDeclines", "keywordAccepts", "keywordCancels",
       "unsubscribes"].forEach(function(field) {
        expect(body[field]).to.be.at.least(0);
      });
    }
  });
}

docs {
  Story 16.3 AC3: GET /events/{eventCode}/mails/counts. Read-only.
  Story 16.2a AC8: also the automatic inbound counts per kind.
}
