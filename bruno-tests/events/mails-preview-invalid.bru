meta {
  name: Mail composer — preview rejects a foreign template (400)
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/events/BATbern59/mails/preview
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerAuthToken}}
}

body:json {
  {
    "audience": "NEWSLETTER",
    "templateKey": "slides-online"
  }
}

tests {
  test("a registrant-notice template is not a newsletter: 400 (404 where BATbern59 is not seeded)", function() {
    expect([400, 404]).to.include(res.getStatus());
  });
}

docs {
  Story 16.8a AC10: the backend owns validation. A template of another audience is rejected
  before anything is rendered or sent.
}
