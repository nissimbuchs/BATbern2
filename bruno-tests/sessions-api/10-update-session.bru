meta {
  name: Update Session
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/events/{{createdEventCode}}/sessions/{{createdSessionSlug}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "title": "Opening Keynote - Updated",
    "description": "Updated session description",
    "durationMinutes": 90
  }
}

assert {
  res.status: eq 200
}

tests {
  test("should return 200 status", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("should update session with sessionSlug (Story 1.16.2)", function() {
    const session = res.getBody();
    expect(session.sessionSlug).to.equal(bru.getVar("createdSessionSlug"));
    expect(session.title).to.equal('Opening Keynote - Updated');
    expect(session.description).to.equal('Updated session description');
  });

  test("should verify no UUID id field (Story 1.16.2)", function() {
    const session = res.getBody();
    expect(session.id).to.be.undefined;
  });
}
