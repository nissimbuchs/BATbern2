meta {
  name: Pretest cleanup — sweep leftover BRUNO-TEST-* events (cascades sessions)
  type: http
  seq: 0
}

post {
  url: {{baseUrl}}/admin/test-fixtures/ems/cleanup
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: {{$guid}}
  Content-Type: application/json
}

body:json {
  {
    "entityType": "events",
    "prefix": "BRUNO-TEST-"
  }
}

tests {
  test("pretest cleanup accepted (200) or gracefully missing (404)", function() {
    expect([200, 204, 404]).to.include(res.getStatus());
  });

  test("if 200, deletion counts are reported", function() {
    if (res.getStatus() === 200) {
      const body = res.getBody();
      expect(body.deletionCounts).to.be.an("object");
      expect(body.deletionCounts.events).to.be.a("number");
    }
  });
}

docs {
  PR 2 split (plan §B3): sweeping events cascades sessions + session_users +
  session_materials, which is the entire blast radius for this collection.
  No separate SESSIONS cleanup call needed — the parent-event sweep is
  sufficient given every session in this collection is created against a
  BRUNO-TEST-* event.
}
