meta {
  name: Fixture — create parent event for session tests
  type: http
  seq: 0.5
}

post {
  url: {{baseUrl}}/events
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

script:pre-request {
  const now = Date.now();
  const eventNumber = 10000 + Math.floor(Math.random() * 90000); // reserved test range (>=10000), swept by ems/events_by_number (event-fixture leak fix)

  bru.setVar("testTimestamp", now);
  bru.setVar("eventNumber", eventNumber);
}

body:json {
  {
    "title": "Bruno Sessions Fixture Event {{testTimestamp}}",
    "eventNumber": {{eventNumber}},
    "date": "2026-03-15T09:00:00Z",
    "registrationDeadline": "2026-03-01T23:59:59Z",
    "venueName": "Sessions Test Venue",
    "venueAddress": "Test Address 3, 3000 Bern",
    "venueCapacity": 100,
    "workflowState": "CREATED",
    "organizerUsername": "{{organizerUsername}}",
    "description": "Parent event for sessions-api tests (PR 2 split)",
    "eventType": "EVENING"
  }
}

assert {
  res.status: eq 201
  res.body.eventCode: isDefined
}

tests {
  test("fixture event created", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("createdEventCode + createdEventNumber published for downstream tests", function() {
    const event = res.getBody();
    bru.setVar("createdEventCode", event.eventCode);
    bru.setVar("createdEventNumber", event.eventNumber);
  });
}

docs {
  PR 2 split (plan §C "sessions-api ... fixture event setup"): owns the
  parent event that tests 08-11 + 20-28 attach sessions to. Replaces the
  cross-collection dependency on events-crud-api/03-create-event that
  used to set `createdEventCode` in the monolithic events-api collection.

  Server auto-generates eventCode as `BATbern<eventNumber>` — does NOT
  match the BRUNO-TEST- canonical prefix the cleanup endpoint accepts.
  Therefore 98-delete-fixture-event.bru explicitly DELETEs by eventCode
  at the end of the run; 99-posttest-cleanup is a no-op safety net.
  Normalizing the test data to a canonical `BRUNO-TEST-<ts>` eventCode
  is PR 10's audit pass scope (plan §D step 2 — "Normalize prefix").
}
