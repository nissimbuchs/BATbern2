meta {
  name: Posttest cleanup — final sweep of BRUNO-TEST-* events
  type: http
  seq: 99
}

post {
  url: {{baseUrl}}/admin/test-fixtures/ems/cleanup
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: {{$guid}}
  Content-Type: application/json
}

body:json {
  {
    "entityType": "events",
    "prefix": "BRUNO-TEST-"
  }
}

tests {
  test("posttest cleanup accepted (200) or gracefully missing (404)", function() {
    expect([200, 204, 404]).to.include(res.getStatus());
  });

  test("if 200, deletion counts are reported", function() {
    if (res.getStatus() === 200) {
      const body = res.getBody();
      expect(body.deletionCounts).to.be.an("object");
      expect(body.deletionCounts.events).to.be.a("number");
    }
  });
}

docs {
  PR 2 split (plan §B3): posttest sweep of BRUNO-TEST-* events.
  67-cleanup-topic-test-event already explicitly deletes the fixture from
  30a, but this belt-and-suspenders sweep catches any orphan if 67 crashed
  or didn't run. Paired with 99a- which sweeps bruno-test-topic-* topics.
}
