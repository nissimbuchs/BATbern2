meta {
  name: Cleanup Topic Test Event
  type: http
  seq: 67
}

delete {
  url: {{baseUrl}}/events/{{createdEventCode}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

assert {
  res.status: eq 204
}

tests {
  test("should delete topic test event created in 30a", function() {
    // Accept both 204 (deleted) and 404 (already deleted)
    const status = res.getStatus();
    expect([204, 404]).to.include(status);
  });

  test("publish topicDeletedEventCode + status for 67a-verify-event-deleted", function() {
    // PR 6 (plan §D step 4): hand the eventCode + DELETE status to 67a.
    // Status discriminates: 204 → assert 404 in GET; 404 → already gone,
    // still assert 404; no other branches expected.
    bru.setVar("topicDeletedEventCode", bru.getVar("createdEventCode"));
    bru.setVar("topicDeleteStatus", res.getStatus());
  });
}
