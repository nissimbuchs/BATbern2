meta {
  name: Posttest cleanup — final sweep of bruno-test-topic-* topics
  type: http
  seq: 99.5
}

post {
  url: {{baseUrl}}/admin/test-fixtures/ems/cleanup
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: {{$guid}}
  Content-Type: application/json
}

body:json {
  {
    "entityType": "topics",
    "prefix": "bruno-test-topic-"
  }
}

tests {
  test("posttest cleanup accepted (200) or gracefully missing (404)", function() {
    expect([200, 204, 404]).to.include(res.getStatus());
  });

  test("if 200, deletion counts are reported", function() {
    if (res.getStatus() === 200) {
      const body = res.getBody();
      expect(body.deletionCounts).to.be.an("object");
      expect(body.deletionCounts.topics).to.be.a("number");
    }
  });
}

docs {
  PR 2 split (plan §B3): posttest sweep of bruno-test-topic-* topics.
  Topics are NOT cascaded by event deletion; they accumulate unless swept
  explicitly. The 31-create-topic test creates a topic per run.
}
