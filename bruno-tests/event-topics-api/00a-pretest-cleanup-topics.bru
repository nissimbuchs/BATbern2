meta {
  name: Pretest cleanup — sweep leftover bruno-test-topic-* topics
  type: http
  seq: 0.1
}

post {
  url: {{baseUrl}}/admin/test-fixtures/ems/cleanup
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: {{$guid}}
  Content-Type: application/json
}

body:json {
  {
    "entityType": "topics",
    "prefix": "bruno-test-topic-"
  }
}

tests {
  test("pretest cleanup accepted (200) or gracefully missing (404)", function() {
    expect([200, 204, 404]).to.include(res.getStatus());
  });

  test("if 200, deletion counts are reported", function() {
    if (res.getStatus() === 200) {
      const body = res.getBody();
      expect(body.deletionCounts).to.be.an("object");
      expect(body.deletionCounts.topics).to.be.a("number");
    }
  });
}

docs {
  PR 2 split (plan §B3): pretest sweep of bruno-test-topic-* topics.
  Topics are independent of events (no FK cascade either direction) and need
  their own cleanup call. 31-create-topic creates bruno-test-topic-{{ts}}
  rows that need explicit cleanup or they accumulate across runs.
}
