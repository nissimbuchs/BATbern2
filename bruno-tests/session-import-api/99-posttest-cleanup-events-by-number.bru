meta {
  name: Posttest cleanup — force-delete fixture events by reserved number range
  type: http
  seq: 99
}

post {
  url: {{baseUrl}}/admin/test-fixtures/ems/cleanup
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: {{$guid}}
  Content-Type: application/json
}

body:json {
  {
    "entityType": "events_by_number",
    "prefix": "10000"
  }
}

tests {
  test("posttest cleanup accepted (200) or gracefully missing (404)", function() {
    expect([200, 204, 404]).to.include(res.getStatus());
  });
}

docs {
  Story 4.10b: force-deletes every event with event_number >= 10000 (the reserved test range
  of 00). Same sweep as participants-api/99.
}
