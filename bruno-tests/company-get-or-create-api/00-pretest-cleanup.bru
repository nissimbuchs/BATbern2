meta {
  name: Pretest cleanup — sweep any leftover BRUNOTESTCO* companies
  type: http
  seq: 0
}

post {
  url: {{baseUrl}}/admin/test-fixtures/cums/cleanup
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: {{$guid}}
  Content-Type: application/json
}

body:json {
  {
    "entityType": "companies",
    "prefix": "BRUNOTESTCO"
  }
}

tests {
  test("pretest cleanup accepted (200) or gracefully missing (404)", function() {
    expect([200, 204, 404]).to.include(res.getStatus());
  });

  test("if 200, deletion counts are reported", function() {
    if (res.getStatus() === 200) {
      const body = res.getBody();
      expect(body.deletionCounts).to.be.an("object");
      expect(body.deletionCounts.companies).to.be.a("number");
    }
  });
}

docs {
  Pretest sweep of company-get-or-create-api (Story 4.10d): removes every company whose key starts
  with BRUNOTESTCO (ignoring case) before the collection, so a company left by an aborted run
  cannot turn the 201 of 01 into a 200. Dev-only collection; a 404 (endpoint missing) is tolerated
  so the sweep never fails the run.
}
