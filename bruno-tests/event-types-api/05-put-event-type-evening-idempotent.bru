meta {
  name: PUT EVENING with captured baseline (round-trip)
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/events/types/EVENING
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {}
}

script:pre-request {
  req.setBody(JSON.parse(bru.getVar("eveningBaseline")));
}

tests {
  test("should return 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("response echoes the full captured baseline, start and end time included", function() {
    const body = res.getBody();
    const baseline = JSON.parse(bru.getVar("eveningBaseline"));
    expect(body.type).to.equal("EVENING");
    Object.keys(baseline).forEach((f) => {
      expect(body[f], f).to.deep.equal(baseline[f]);
    });
  });
}

docs {
  PR 2a: idempotent-PUT pattern, call #1. Replays the captured EVENING
  config from test 04 and asserts the response reflects the same values.
  Test 06 calls PUT a second time with the same body and asserts the
  response is still identical — that's the idempotency invariant.

  Story 5.1 AC3/AC8 guards: minSlots > 0, maxSlots >= minSlots,
  slotDuration >= 15, defaultCapacity > 0. The captured baseline always
  satisfies these (we just GET'd it), so this PUT never trips validation.
}
