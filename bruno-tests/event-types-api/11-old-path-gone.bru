meta {
  name: Old /events/types path serves no event types (4.10b)
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/events/types
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("should answer 4xx: 'types' is read as an event code now", function() {
    expect(res.getStatus()).to.be.within(400, 499);
  });

  test("should not return an event type list", function() {
    expect(Array.isArray(res.getBody())).to.equal(false);
  });
}

docs {
  Story 4.10b, breaking, no alias: GET /events/types falls on GET /events/{eventCode}, which
  rejects "types" (pattern) or finds no event. Read-only, safe on every environment.
}
