meta {
  name: PUT EVENING again — idempotency check
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/events/types/EVENING
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {}
}

script:pre-request {
  req.setBody(JSON.parse(bru.getVar("eveningBaseline")));
}

tests {
  test("should return 200 — second PUT with same body is still accepted", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("response echoes the full captured baseline, start and end time included", function() {
    const body = res.getBody();
    const baseline = JSON.parse(bru.getVar("eveningBaseline"));
    expect(body.type).to.equal("EVENING");
    Object.keys(baseline).forEach((f) => {
      expect(body[f], f).to.deep.equal(baseline[f]);
    });
  });
}

docs {
  PR 2a: idempotency check. PUT with the same body twice in a row must
  yield the same observable response. If the underlying handler had a
  hidden side-effect (e.g., incrementing a version counter that altered
  the response shape, or rejecting same-body retries with 409), this
  test would catch it.

  Combined with test 05, this verifies the OpenAPI-documented
  "Update event type configuration ... Cache is automatically
  invalidated after successful update" semantics: cache invalidation
  doesn't break round-trip on a no-op update.
}
