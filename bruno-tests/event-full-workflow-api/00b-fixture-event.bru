meta {
  name: Fixture — create event for workflow tests
  type: http
  seq: 0.5
}

post {
  url: {{baseUrl}}/events
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

script:pre-request {
  const now = Date.now();
  const eventNumber = 10000 + Math.floor(Math.random() * 90000); // reserved test range (>=10000), swept by ems/events_by_number (event-fixture leak fix)

  bru.setVar("testTimestamp", now);
  bru.setVar("eventNumber", eventNumber);
}

body:json {
  {
    "title": "Bruno Workflow Fixture Event {{testTimestamp}}",
    "eventNumber": {{eventNumber}},
    "date": "2026-05-15T09:00:00Z",
    "registrationDeadline": "2026-05-01T23:59:59Z",
    "venueName": "Workflow Test Venue",
    "venueAddress": "Test Address 5, 3000 Bern",
    "venueCapacity": 100,
    "workflowState": "CREATED",
    "organizerUsername": "{{organizerUsername}}",
    "description": "Parent event for event-full-workflow-api tests (PR 2 split)",
    "eventType": "EVENING"
  }
}

assert {
  res.status: eq 201
  res.body.eventCode: isDefined
}

tests {
  test("fixture event created", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("createdEventCode + createdEventNumber published for downstream tests", function() {
    const event = res.getBody();
    bru.setVar("createdEventCode", event.eventCode);
    bru.setVar("createdEventNumber", event.eventNumber);
  });
}

docs {
  PR 2 split (plan §C): owns the parent event that the seed tests
  (12 list-registrations, 13 create-registration, 16 publish-event) run
  against. PR 2b will replace this with a richer state-machine fixture
  that walks all 8 workflow states. For now, a single fresh CREATED-state
  event is enough for the 3 seed tests.

  16-publish-event probably returns 422 here because the event lacks
  sessions/speakers/registrations needed for publish to succeed — that's
  expected (test asserts oneOf([200, 422])). Event remains in CREATED,
  which 98-delete-fixture-event can DELETE without state-transition help.
}
