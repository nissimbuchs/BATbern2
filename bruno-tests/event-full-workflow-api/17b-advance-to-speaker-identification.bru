meta {
  name: Advance workflow event TOPIC_SELECTION → SPEAKER_IDENTIFICATION
  type: http
  seq: 17.2
}

put {
  url: {{baseUrl}}/events/{{workflowEventCode}}/workflow/transition
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "targetState": "SPEAKER_IDENTIFICATION",
    "overrideValidation": true,
    "overrideReason": "PR 2b state-machine walk"
  }
}

tests {
  test("transition succeeds with 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("response reflects target state", function() {
    expect(res.getBody().workflowState).to.equal("SPEAKER_IDENTIFICATION");
  });
}

