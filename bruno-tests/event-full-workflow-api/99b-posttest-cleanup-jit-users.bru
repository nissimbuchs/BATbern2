meta {
  name: Posttest cleanup — sweep JIT users created by anonymous registration (issue #725)
  type: http
  seq: 100
}

post {
  url: {{baseUrl}}/admin/test-fixtures/cums/cleanup
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: {{$guid}}
  Content-Type: application/json
}

body:json {
  {
    "entityType": "users_by_email",
    "prefix": "@e2e.batbern.invalid"
  }
}

tests {
  test("posttest cleanup accepted (200) or gracefully missing (404)", function() {
    expect([200, 204, 404]).to.include(res.getStatus());
  });

  test("if 200, user_profiles deletion count is reported", function() {
    if (res.getStatus() === 200) {
      const body = res.getBody();
      expect(body.deletionCounts).to.be.an("object");
      expect(body.deletionCounts.user_profiles).to.be.a("number");
    }
  });
}

docs {
  Issue #725: 13-create-registration.bru posts an anonymous registration with
  email test.attendee@e2e.batbern.invalid, which JIT-creates a user_profiles row
  (username test.attendee). Deleting the BRUNO-TEST-* event in 99-posttest-cleanup
  cascades the EMS registration row but NOT the CUMS user_profiles row — that lives
  in a different service/DB and has no bruno.test username, so the username sweep
  can't reach it. This sweep removes it by synthetic email DOMAIN (suffix match),
  the only safe discriminator from real anonymous attendees. role_assignments and
  user_additional_emails cascade via FK ON DELETE CASCADE.
}
