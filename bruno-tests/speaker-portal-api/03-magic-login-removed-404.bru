meta {
  name: Magic-login endpoint removed → 404 (Story 11.F.1 AC2 / AC7)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/speaker-magic-login
  body: json
  auth: none
}

body:json {
  {
    "token": "any-value-should-not-reach-a-handler"
  }
}

tests {
  test("should reject (401 or 404) since handler was deleted by Story 11.F.1 AC1", function() {
    // SpeakerMagicLoginController + MagicLinkService were deleted in Phase F. The
    // permitAll matcher in api-gateway SecurityConfig for /api/v1/auth/speaker-magic-login
    // was also removed in 11.F.1. So an unauthenticated POST now hits Spring Security
    // first (no token → 401) before ever reaching the dispatcher's NoHandlerFound
    // branch (which would emit 404). Either status confirms the endpoint is no longer
    // functional — 401 is what the deployed gateway returns to unauthenticated callers
    // post-11.F.1.
    expect([401, 404]).to.include(res.getStatus());
  });
}
