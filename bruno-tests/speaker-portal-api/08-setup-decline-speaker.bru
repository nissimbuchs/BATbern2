meta {
  name: Setup Speaker for Decline Test
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/events/{{speakerPortalTestEventCode}}/speakers/invite
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

script:pre-request {
  // PR 11: firstName=Bruno, lastName=Test convention for CUMS cleanup-regex match.
  // Capture the email so 08b-promote can re-use it (CUMS getOrCreateUser is idempotent
  // on email).
  bru.setVar("declineSpeakerEmail", "bruno-test-decline-" + Date.now() + "@e2e.batbern.invalid");
}

body:json {
  {
    "email": "{{declineSpeakerEmail}}",
    "firstName": "Bruno",
    "lastName": "Test",
    "company": "Test Decline AG"
  }
}

script:post-response {
  if (res.getStatus() === 200 || res.getStatus() === 201) {
    bru.setVar("declineSpeakerUsername", res.getBody().username);
    bru.setVar("declineSpeakerPoolId", res.getBody().speakerPoolId);
  }
}

tests {
  test("should create speaker for decline test", function() {
    const status = res.getStatus();
    expect(status === 200 || status === 201).to.be.true;
  });
}
