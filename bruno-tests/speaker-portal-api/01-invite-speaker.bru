meta {
  name: Add Speaker to the Pool (Story 5.2; was POST /speakers/invite until Story 4.10)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/events/{{speakerPortalTestEventCode}}/speakers
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

script:pre-request {
  // PR 11: firstName=Bruno, lastName=Test makes the username generated at promote (01b) match
  // the CUMS USERS cleanup regex `^bruno\.test\.?$`. Same convention as speaker-pool-api tests
  // 38, 45–47. The e-mail is captured here and attached at promote (01b): the pool add rejects
  // an e-mail (AR23).
  bru.setVar("inviteSpeakerEmail", "bruno-test-portal-" + Date.now() + "@e2e.batbern.invalid");
}

body:json {
  {
    "speakerName": "Bruno Test",
    "company": "Test Company AG",
    "notes": "Software Architecture, Cloud Computing"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

tests {
  test("adds the speaker to the pool at IDENTIFIED", function() {
    expect(res.getStatus()).to.equal(201);
    const body = res.getBody();
    expect(body.status).to.equal('IDENTIFIED');
    bru.setVar("invitedSpeakerPoolId", body.id);
  });
}

docs {
  Story 4.10 removed the test-only POST /events/{eventCode}/speakers/invite (no UI caller).
  The collection now takes the organizer UI's golden path: pool add (here), CONTACTED (01a),
  promote with the e-mail (01b, provisions the user and the username), send-invitation by the
  pool entry id (02).
}
