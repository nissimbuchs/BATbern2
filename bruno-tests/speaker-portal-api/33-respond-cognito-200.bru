meta {
  name: Respond 200 with SPEAKER token + eventCode in path (Story 11.E.3 AC1+AC2+AC10)
  type: http
  seq: 33
}

# Pre-req: a SPEAKER pool row in INVITED state exists for `{{speakerAuthToken}}`'s username
# on `{{speakerPortalEventCode}}` (provisioned by Story 11.E.2 + seed). The test asserts
# the contract shape, not the side effects (status transitions are unit-tested).

post {
  url: {{baseUrl}}/speaker-portal/events/{{speakerPortalEventCode}}/respond
  body: json
  auth: bearer
}

auth:bearer {
  token: {{speakerAuthToken}}
}

body:json {
  {
    "response": "ACCEPT"
  }
}

assert {
  res.status: in [200, 409]
}

tests {
  test("should accept response via Cognito Bearer (Story 11.E.3 AC1+AC2)", function() {
    // 200 = first response; 409 = speaker already responded (replayable assertion).
    const status = res.getStatus();
    expect([200, 409]).to.include(status);
  });
}
