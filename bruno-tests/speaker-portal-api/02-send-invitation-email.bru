meta {
  name: Send Invitation Email (Story 6.1b)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/events/{{speakerPortalTestEventCode}}/speakers/{{invitedSpeakerUsername}}/send-invitation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

script:pre-request {
  const d = new Date(Date.now() + 30 * 24 * 3600 * 1000);
  bru.setVar("inviteResponseDeadline", d.toISOString().slice(0, 10));
}

body:json {
  {
    "responseDeadline": "{{inviteResponseDeadline}}"
  }
}

assert {
  res.status: eq 200
  res.body.status: isDefined
}

tests {
  test("should send invitation email - Story 6.1b AC4", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("should transition workflow state to INVITED - Story 6.1b AC5", function() {
    const body = res.getBody();
    expect(body.status).to.equal('INVITED');
  });

  test("should set invitedAt timestamp - Story 6.1b AC6", function() {
    const body = res.getBody();
    expect(body.invitedAt).to.be.a('string');
  });
}

docs {
  2026-10-07: the response deadline was hard-coded to 2026-07-01 and has been
  rejected ("Response deadline must be in the future") since that date. It is
  now computed 30 days ahead in script:pre-request.
}
