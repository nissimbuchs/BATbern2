meta {
  name: Mark many read (PATCH /notifications); unknown and already-read ids are not counted
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/notifications
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "notificationIds": ["{{notifId}}", "00000000-0000-4000-8000-000000000001"],
    "status": "READ"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("an unknown id and a notification already read change nothing", function() {
    expect(res.getBody().success).to.equal(true);
    expect(res.getBody().markedCount).to.equal(0);
  });
}

docs {
  Story 4.10b: replaces PUT /notifications/batch-read. Ids that are not the caller's (here one
  that does not exist) are ignored. markedCount counts the notifications that changed (spec), and
  {{notifId}} was already marked read by 03, so nothing changes here. The positive bulk case
  (several unread, counted) is covered by NotificationControllerIntegrationTest.
}
