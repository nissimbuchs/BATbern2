meta {
  name: Send calendar invite for the meeting
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/partner-meetings/{{createdMeetingId}}/send-invite
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: {{$guid}}
  Accept: application/json
}

assert {
  res.status: eq 202
}

tests {
  test("returns 202 Accepted — invite dispatched asynchronously", function() {
    expect(res.getStatus()).to.equal(202);
  });

  test("response echoes the meeting id and a recipient count", function() {
    const body = res.getBody();
    expect(body.meetingId).to.equal(bru.getVar("createdMeetingId"));
    expect(body.recipientCount).to.be.a("number");
  });
}

docs {
  PartnerMeetingController.sendInvite returns 202 immediately (AC8);
  PartnerInviteEmailService.sendCalendarInvites is @Async, so the HTTP response
  does not depend on SES delivery succeeding. The synchronous path (EMS
  getEventSummary + recipient collection + ICS generation) runs before the 202.
  This also flips invite_sent_at, so the later DELETE exercises the
  METHOD:CANCEL branch of deleteMeeting (also @Async).
}
