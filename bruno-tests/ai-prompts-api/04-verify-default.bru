meta {
  name: A read shows the default text
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/ai-prompts/event_description
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("promptText equals defaultText after a reload", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().promptText).to.equal(bru.getVar("aiPromptDefaultText"));
  });
}
