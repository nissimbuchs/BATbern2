meta {
  name: Delete Additional Email (10.32)
  type: http
  seq: 17
}

delete {
  url: {{baseUrl}}/users/me/additional-emails/{{additionalEmailId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: {{$guid}}
  Accept: application/json
}

script:pre-request {
  // fail fast if test 15 was skipped, instead of a DELETE to an empty segment
  const id = bru.getVar("additionalEmailId");
  if (!id) {
    throw new Error("Precondition: runtime var `additionalEmailId` is unset. Run test 15 (add-additional-email) first.");
  }
}

assert {
  res.status: eq 204
}

tests {
  test("should return 204 on successful delete", function() {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  Story 4.10d: the address is removed by its id (`AdditionalEmail.id` from test 15); the
  address itself never goes in the path. Review 2026-05-22 P3-4: the pre-request script
  fails fast when test 15 did not run.
}
