meta {
  name: Get User by Username (Read Test User)
  type: http
  seq: 5
}

script:pre-request {
  // Precondition (added 2026-09-09). Read-only, but it must not silently report on the
  // authenticated organizer when 04-create-user failed — that turned a missing throwaway user
  // into a green assertion about the wrong account. See 06-update-user-roles for the mutating
  // case that made this dangerous.
  if (!bru.getVar("testUsername")) {
    throw new Error(
      "Precondition: runtime var `testUsername` is unset — 04-create-user must succeed first."
    );
  }
}

get {
  url: {{baseUrl}}/users/{{testUsername}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: {{$guid}}
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.id: eq {{testUsername}}
}

tests {
  test("should get user by username successfully (AC5)", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("should return user with correct username", function() {
    const body = res.getBody();
    const testUsername = bru.getVar("testUsername");
    expect(body.id).to.equal(testUsername);
  });

  test("should return test user created in previous step", function() {
    const body = res.getBody();
    const testEmail = bru.getVar("testUserEmail");
    expect(body.email).to.equal(testEmail);
    expect(body.firstName).to.equal("Bruno");
    // Plan §F2: 04-create-user sets lastName='Test' so the derived username
    // (`bruno.test` / `bruno.test.N`) matches the safety guard in 95-delete-test-user.
    expect(body.lastName).to.equal("Test");
  });

  test("should return in reasonable time", function() {
    // Performance targets vary by environment (local vs production)
    expect(res.getStatus()).to.equal(200);
  });
}
