meta {
  name: Validation - larger than 5 MB is 400
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/uploads/profile-picture
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: {{$guid}}
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "fileName": "bruno-test-{{$timestamp}}.png",
    "contentType": "image/png",
    "size": 6291456,
    "target": {
      "username": "{{currentUsername}}"
    }
  }
}

assert {
  res.status: eq 400
}

tests {
  test("should say the size limit", function() {
    expect(res.getBody().message).to.include('5 MB');
  });

  test("should include correlation ID for troubleshooting", function() {
    expect(res.getBody().correlationId).to.exist;
  });
}

docs {
  Story 17.11a: the 5 MB limit of purpose profile-picture (uploads-api), checked on the
  reservation.
}
