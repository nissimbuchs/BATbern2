meta {
  name: Issue Invitation Credentials (Story 11.E.2)
  type: http
  seq: 25
}

post {
  url: {{baseUrl}}/users/bruno.testspeaker/issue-invitation-credentials
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: {{$guid}}
  Accept: application/json
}

assert {
  res.status: in [200, 401, 403, 404, 422, 502]
}

tests {
  test("issue invitation credentials returns a known status (Story 11.E.2 AR15/FR9)", function() {
    const status = res.getStatus();
    expect([200, 401, 403, 404, 422, 502]).to.include(status);
  });

  test("on 200 — action discriminator present + temporaryPassword shape matches action", function() {
    if (res.getStatus() === 200) {
      const body = res.getBody();
      expect(body).to.have.property('action').that.is.a('string');
      expect(['FRESH_TEMP_PASSWORD', 'USE_EXISTING_PASSWORD']).to.include(body.action);

      if (body.action === 'FRESH_TEMP_PASSWORD') {
        // Fresh path — non-empty temp password (16-char default; ≥ 8 minimum per pool policy).
        expect(body).to.have.property('temporaryPassword').that.is.a('string').and.not.empty;
        expect(body.temporaryPassword.length).to.be.at.least(8);
      } else {
        // Use-existing path — temporaryPassword must be null/missing.
        if (body.temporaryPassword !== undefined) {
          expect(body.temporaryPassword).to.be.null;
        }
      }
    }
  });

  test("on 422 — body carries a clear operator-intervention message", function() {
    if (res.getStatus() === 422) {
      const body = res.getBody();
      expect(body).to.have.property('status', 422);
      expect(body).to.have.property('message').that.is.a('string').and.not.empty;
    }
  });
}
