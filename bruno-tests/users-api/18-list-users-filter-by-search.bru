meta {
  name: List Users - Filter by Search (name)
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/users?search=test&page=1&limit=20
  body: none
  auth: bearer
}

params:query {
  search: test
  page: 1
  limit: 20
}

headers {
  X-Correlation-ID: {{$guid}}
  Accept: application/json
}

auth:bearer {
  token: {{authToken}}
}

assert {
  res.status: in [200, 403, 429]
}

tests {
  test("should filter users by name search successfully", function() {
    const status = res.getStatus();
    expect([200, 403, 429]).to.include(status);
    if (status === 403) {
      console.log("Non-admin/organizer - access denied (expected)");
    }
  });
  
  test("should return users matching search query", function() {
    if (res.getStatus() === 200) {
      const body = res.getBody();
      expect(body.data).to.be.an('array');
  
      console.log(`Found ${body.data.length} users matching 'test'`);
    }
  });
  
  test("should return pagination metadata", function() {
    if (res.getStatus() === 200) {
      const body = res.getBody();
      expect(body.pagination).to.exist;
    }
  });
}

docs {
  The search also matches additional e-mail addresses and folded spellings (ü = ue = u), which
  are not all in the returned user fields, so the rows are not checked field by field here; the
  matching itself is covered by the CUMS integration tests.
}
