meta {
  name: Get Current User
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/users/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: {{$guid}}
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.id: isDefined
  res.body.email: isDefined
}

script:post-response {
  // Store current user data for subsequent tests.
  //
  // These are RUNTIME vars (bru.setVar), not env vars. bru.setEnvVar writes back into the
  // tracked environment file, so every run dirtied bruno-tests/environments/*.bru and left
  // captured profile values in the working tree — including, after a failed restore, the
  // literal "Updated"/"User" placeholders. All of these vars are consumed only inside the
  // users-api collection, which is a single `bru run` invocation, so runtime scope is enough.
  // (`testUsername` in 04-create-user.bru deliberately stays an env var: tasks-api reads it
  // from a SEPARATE invocation and depends on it being persisted.)
  if (res.getStatus() === 200) {
    const user = res.getBody();
    bru.setVar("currentUsername", user.id);
    bru.setVar("currentUserEmail", user.email);
    // Plan §F1 fix: 18-add-additional-email-duplicate reads {{authUserEmail}};
    // earlier this var was never defined so the body sent the literal
    // string "{{authUserEmail}}" and the server rejected it with 400. Setting
    // the alias here keeps test 18 self-contained without altering its body.
    bru.setVar("authUserEmail", user.email);

    // Store original profile data for restoration after update tests
    bru.setVar("originalFirstName", user.firstName || "");
    bru.setVar("originalLastName", user.lastName || "");
    bru.setVar("originalBio", user.bio || "");
    bru.setVar("originalProfilePictureUrl", user.profilePictureUrl || "");

    // Gate for the destructive 03 → 03b pair. PATCH /users/me rejects a blank firstName or
    // lastName with 400, so a profile whose name is already blank CANNOT be restored: 03
    // would set it to "Updated"/"User" and 03b's restore would 400, permanently renaming a
    // real account. On staging — which IS production — that account is a live organizer.
    // Observed 2026-09-09 against local dev, where the anonymized organizer has empty names.
    const restorable =
      typeof user.firstName === 'string' && user.firstName.trim().length > 0 &&
      typeof user.lastName === 'string' && user.lastName.trim().length > 0;
    bru.setVar("profileRestorable", restorable);
    if (!restorable) {
      console.log(
        "SKIPPING the update/restore pair: firstName/lastName are blank, so the original " +
        "profile cannot be restored. Refusing to mutate a profile we cannot put back."
      );
    }

    console.log("Current user username:", user.id);
    console.log("Stored original profile:", {
      firstName: user.firstName,
      lastName: user.lastName,
      bio: user.bio,
      restorable: restorable
    });
  }
}

tests {
  test("should return current authenticated user", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("should return user with username as id (Story 1.16.2)", function() {
    const body = res.getBody();
    expect(body.id).to.exist;
    expect(body.id).to.be.a('string');
    expect(body.id).to.match(/^[a-z]+\.[a-z]+(\.[0-9]+)?$/); // username format
  });

  test("should return user with all basic fields", function() {
    const body = res.getBody();
    expect(body.email).to.exist;
    expect(body.firstName).to.exist;
    expect(body.lastName).to.exist;
    expect(body.roles).to.be.an('array');
  });

  test("should return in reasonable time", function() {
    // Performance targets vary by environment (local vs production)
    // Just verify we get a response (not testing specific timing)
    expect(res.getStatus()).to.equal(200);
  });
}
