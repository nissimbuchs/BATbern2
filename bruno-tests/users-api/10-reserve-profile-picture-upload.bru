meta {
  name: Reserve a profile-picture upload for the own user
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/uploads/profile-picture
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: {{$guid}}
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "fileName": "bruno-test-{{$timestamp}}.png",
    "contentType": "image/png",
    "size": 4,
    "target": {
      "username": "{{currentUsername}}"
    }
  }
}

assert {
  res.status: eq 201
  res.body.uploadId: isDefined
  res.body.uploadUrl: isDefined
  res.body.expiresAt: isDefined
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("profilePictureUploadId", res.getBody().uploadId);
  }
}

tests {
  test("should reserve the upload with a presigned S3 PUT", function() {
    const body = res.getBody();
    expect(body.uploadId).to.be.a('string');
    // AWS S3 (staging/production) or MinIO (local development)
    const isS3 = body.uploadUrl.includes('amazonaws.com') || body.uploadUrl.includes('localhost:8450');
    expect(isS3).to.be.true;
  });

  test("should name the signed Content-Type", function() {
    expect(res.getBody().requiredHeaders['Content-Type']).to.equal('image/png');
  });
}

docs {
  Story 17.11a: profile pictures run on the upload contract (uploads-api), purpose
  profile-picture, owned by company-user-management. The target username is required; the user
  themself or an organizer may name it ({{currentUsername}} is the caller, set by 01). Another
  user's picture with a non-organizer token (403) needs a second identity here; the CUMS
  ProfilePictureUploadIntegrationTest covers it. The reservation stays PENDING and is deleted by the
  nightly upload expiry: nothing is attached, so the caller's real picture does not change.
}
