meta {
  name: Update User Roles (Admin/Organizer)
  type: http
  seq: 6
}

script:pre-request {
  // Precondition (added 2026-09-09). This request targets `{{testUsername}}`, the throwaway user
  // created by 04-create-user. That var used to have a committed default of `batbern.organizer`
  // in the environment files, so whenever 04 failed (e.g. 403 on a non-organizer env) this
  // request silently retargeted the REAL authenticated organizer. Here that means PUT /users/{username}/roles would have set the organizer's roles to [ATTENDEE, SPEAKER], stripping ORGANIZER.
  // The default is gone and this check refuses to run rather than resolve to anything else.
  // Staging IS production, so the account at stake is a live organizer.
  const target = bru.getVar("testUsername");
  if (!target) {
    throw new Error(
      "Precondition: runtime var `testUsername` is unset — 04-create-user must succeed first. " +
      "Refusing to issue this request without an explicit throwaway target."
    );
  }
  if (target === bru.getEnvVar("organizerUsername") || target === bru.getEnvVar("testOrganizerUsername")) {
    throw new Error(
      "Precondition: `testUsername` resolved to the organizer account (" + target + "). " +
      "Refusing to mutate it."
    );
  }
}

put {
  url: {{baseUrl}}/users/{{testUsername}}/roles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: {{$guid}}
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "roles": ["ATTENDEE", "SPEAKER"]
  }
}

assert {
  res.status: in [200, 403]
}

tests {
  test("should update user roles successfully (AC3)", function() {
    const status = res.getStatus();
    // Should be 200 for admin/organizer, 403 for others
    expect([200, 403]).to.include(status);
  });

  test("should return updated user with new roles", function() {
    if (res.getStatus() === 200) {
      const body = res.getBody();
      expect(body.roles).to.be.an('array');
      expect(body.roles).to.include('SPEAKER');
      expect(body.roles).to.include('ATTENDEE');
      console.log("Successfully updated roles:", body.roles);
    }
  });

  test("should require admin/organizer role", function() {
    const status = res.getStatus();
    if (status === 403) {
      console.log("Correctly denied access for non-admin/organizer");
    }
  });

  test("should validate minimum organizers (AC3)", function() {
    // If trying to remove last organizer, should return 400
    // This is validated in the backend
    const status = res.getStatus();
    if (status === 400) {
      console.log("Correctly prevented removal of last organizer");
    }
  });

  test("should return in reasonable time", function() {
    // Performance targets vary by environment (local vs production)
    if (res.getStatus() === 200) {
      expect(res.getStatus()).to.equal(200);
    }
  });
}
