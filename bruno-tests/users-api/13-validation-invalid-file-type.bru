meta {
  name: Validation - invalid file type is 400
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/uploads/profile-picture
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: {{$guid}}
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "fileName": "bruno-test-{{$timestamp}}.pdf",
    "contentType": "application/pdf",
    "size": 1048576,
    "target": {
      "username": "{{currentUsername}}"
    }
  }
}

assert {
  res.status: eq 400
}

tests {
  test("should name the allowed types", function() {
    expect(res.getBody().message).to.include('allowed');
  });
}

docs {
  Story 17.11a: purpose profile-picture accepts png, jpeg and svg only.
}
