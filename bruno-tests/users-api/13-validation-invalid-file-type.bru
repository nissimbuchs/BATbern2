meta {
  name: Validation - Invalid File Type
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/users/{{currentUsername}}/picture/presigned-url
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: {{$guid}}
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "fileName": "document.pdf",
    "fileSize": 1048576,
    "mimeType": "application/pdf"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("should reject invalid file type with 400 on /users/{username}/picture (AC10, Story 4.10)", function() {
    // 404 would mean the picture path is gone: Story 4.10 moved it from /users/me/picture.
    expect(res.getStatus()).to.equal(400);
  });

  test("should return error message about allowed file types", function() {
    if (res.getStatus() === 400) {
      const body = res.getBody();
      expect(body.message).to.exist;
      expect(body.message).to.match(/PNG|JPG|JPEG|SVG/i);
    }
  });

  test("should include correlation ID for troubleshooting", function() {
    if (res.getStatus() === 400) {
      const body = res.getBody();
      expect(body.correlationId).to.exist;
    }
  });
}
