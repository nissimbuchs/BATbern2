meta {
  name: Patch User Profile — rejects unknown fields (Story 11.C.2 RD §3)
  type: http
  seq: 26
}

script:pre-request {
  // Precondition (added 2026-09-09). This request targets `{{testUsername}}`, the throwaway user
  // created by 04-create-user. That var used to have a committed default of `batbern.organizer`
  // in the environment files, so whenever 04 failed (e.g. 403 on a non-organizer env) this
  // request silently retargeted the REAL authenticated organizer. This request expects a rejection, so it does not write, but it must still not be aimed at the organizer.
  // The default is gone and this check refuses to run rather than resolve to anything else.
  // Staging IS production, so the account at stake is a live organizer.
  const target = bru.getVar("testUsername");
  if (!target) {
    throw new Error(
      "Precondition: runtime var `testUsername` is unset — 04-create-user must succeed first. " +
      "Refusing to issue this request without an explicit throwaway target."
    );
  }
  if (target === bru.getEnvVar("organizerUsername") || target === bru.getEnvVar("testOrganizerUsername")) {
    throw new Error(
      "Precondition: `testUsername` resolved to the organizer account (" + target + "). " +
      "Refusing to mutate it."
    );
  }
}

patch {
  url: {{baseUrl}}/users/{{testUsername}}/profile
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: {{$guid}}
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "bio": "Bio with a stale legacy field",
    "department": "Engineering"
  }
}

assert {
  res.status: in [400, 401, 403, 404]
}

tests {
  test("should reject payload with unknown fields (additionalProperties: false)", function() {
    const status = res.getStatus();
    // 400 — controller validates request.additionalProperties is empty.
    expect([400, 401, 403, 404]).to.include(status);
  });
}
