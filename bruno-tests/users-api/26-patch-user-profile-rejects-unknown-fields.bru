meta {
  name: Patch User Profile — rejects unknown fields (Story 11.C.2 RD §3)
  type: http
  seq: 26
}

patch {
  url: {{baseUrl}}/users/{{testUsername}}/profile
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: {{$guid}}
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "bio": "Bio with a stale legacy field",
    "department": "Engineering"
  }
}

assert {
  res.status: in [400, 401, 403, 404]
}

tests {
  test("should reject payload with unknown fields (additionalProperties: false)", function() {
    const status = res.getStatus();
    // 400 — controller validates request.additionalProperties is empty.
    expect([400, 401, 403, 404]).to.include(status);
  });
}
