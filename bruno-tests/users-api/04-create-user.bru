meta {
  name: Create User (Admin/Organizer)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: {{$guid}}
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "email": "bruno-test-{{$timestamp}}@e2e.batbern.invalid",
    "firstName": "Bruno",
    "lastName": "Test",
    "initialRoles": ["ATTENDEE"],
    "bio": "Test user created via Bruno API tests"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.email: isDefined
}

script:post-response {
  // Store created user for subsequent tests
  if (res.getStatus() === 201) {
    const user = res.getBody();
    // All RUNTIME vars (bru.setVar), never bru.setEnvVar, which persists into the TRACKED
    // environment file. That mattered twice:
    //   1. It defeated the precondition guards below. Once written, `disposableUsername` stays
    //      "set" on every later run even when THIS request fails, so 95-delete-test-user's
    //      "fail loud instead of nuking the auth user" check would pass on a stale value and
    //      issue a real DELETE.
    //   2. Every run left test residue in the working tree, which is how a run's captured
    //      values nearly got committed on 2026-09-09.
    // `testUsername` used to be an env var because tasks-api read it across a separate
    // `bru run` invocation; tasks-api/04-create-ad-hoc-task.bru now uses the static
    // `{{organizerUsername}}`, which is what `assignedOrganizerUsername` should be anyway,
    // so that coupling is gone.
    bru.setVar("testUsername", user.id);
    // Note: bru.setEnvVar persists into the TRACKED environment file, which
    // defeats the very precondition guards below. Once written, `disposableUsername` stays "set"
    // on every later run even when this request fails, so 95-delete-test-user's "fail loud
    // instead of nuking the auth user" check would pass on a stale value and issue a real
    // DELETE. Runtime scope restores the intended semantics: unset unless THIS run set it.
    bru.setVar("testUserEmail", user.email);
    // Plan §F2 fix: 14-delete-test-user previously reused `testUsername` which
    // also resolves to the AUTH user (`batbern.organizer`) via development.bru
    // when this 04 step fails (e.g. 403 on non-organizer envs). The new
    // `disposableUsername` var is set ONLY by this step, so test 14 can use it
    // safely — if 04 didn't succeed, 14's precondition check will fail loud
    // instead of nuking the auth user.
    bru.setVar("disposableUsername", user.id);
    console.log("Created test user:", user.id);
    console.log("Test user email:", user.email);
  }
}

tests {
  test("should create user successfully (AC4)", function() {
    const status = res.getStatus();
    // Should be 201 for admin/organizer, 403 for others
    expect([201, 403]).to.include(status);
  });

  test("should return created user with username as id", function() {
    if (res.getStatus() === 201) {
      const body = res.getBody();
      expect(body.id).to.exist;
      expect(body.id).to.be.a('string');
      // Username derived from firstName.lastName, with optional .N suffix on
      // collision. Plan §F2: must start with `bruno.test` so the safety guard
      // in 14-delete-test-user accepts it (and never matches the auth user
      // `batbern.organizer`).
      expect(body.id).to.match(/^bruno\.test(\.[0-9]+)?$/);
    }
  });

  test("should return user with all required fields", function() {
    if (res.getStatus() === 201) {
      const body = res.getBody();
      expect(body.email).to.exist;
      expect(body.firstName).to.equal("Bruno");
      expect(body.lastName).to.equal("Test");
      expect(body.roles).to.be.an('array');
      expect(body.roles).to.include('ATTENDEE');
    }
  });

  test("should require admin/organizer role", function() {
    const status = res.getStatus();
    if (status === 403) {
      console.log("Correctly denied access for non-admin/organizer");
    }
  });

  test("should return in reasonable time", function() {
    // Performance targets vary by environment (local vs production)
    // Just verify successful operation, not specific timing
    if (res.getStatus() === 201) {
      expect(res.getStatus()).to.equal(201);
    }
  });
}
