meta {
  name: Pretest cleanup — sweep leftover BRUNO-TEST-* events (cascades event_tasks)
  type: http
  seq: 0
}

post {
  url: {{baseUrl}}/admin/test-fixtures/ems/cleanup
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: {{$guid}}
  Content-Type: application/json
}

body:json {
  {
    "entityType": "events",
    "prefix": "BRUNO-TEST-"
  }
}

tests {
  test("pretest cleanup accepted (200) or gracefully missing (404)", function() {
    expect([200, 204, 404]).to.include(res.getStatus());
  });

  test("if 200, deletion counts are reported", function() {
    if (res.getStatus() === 200) {
      const body = res.getBody();
      expect(body.deletionCounts).to.be.an("object");
      expect(body.deletionCounts.events).to.be.a("number");
    }
  });
}

docs {
  PR 6 (batched audit-pass closeout, plan §B3): canonical pretest hook
  replacing the legacy 00-create-test-event.bru / 99-cleanup-test-event.bru
  pair. event_tasks cascades from events, so sweeping BRUNO-TEST-* events
  catches the entire blast radius for this collection.

  Today's fixture event uses server-generated BATbern{N} code (see
  00b-fixture-event.bru), so the prefix sweep is a no-op for the current
  fixture — explicit DELETE in 98-delete-fixture-event.bru still owns the
  per-run teardown. The hook is in place for the day eventCode becomes
  client-suppliable (filed in plan §"Risks to track").
}
