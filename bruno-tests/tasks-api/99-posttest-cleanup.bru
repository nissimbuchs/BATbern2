meta {
  name: Posttest cleanup — final sweep of BRUNO-TEST-* events (cascades event_tasks)
  type: http
  seq: 99
}

post {
  url: {{baseUrl}}/admin/test-fixtures/ems/cleanup
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Correlation-ID: {{$guid}}
  Content-Type: application/json
}

body:json {
  {
    "entityType": "events",
    "prefix": "BRUNO-TEST-"
  }
}

tests {
  test("posttest cleanup accepted (200) or gracefully missing (404)", function() {
    expect([200, 204, 404]).to.include(res.getStatus());
  });

  test("if 200, deletion counts are reported", function() {
    if (res.getStatus() === 200) {
      const body = res.getBody();
      expect(body.deletionCounts).to.be.an("object");
      expect(body.deletionCounts.events).to.be.a("number");
    }
  });
}

docs {
  PR 6 (plan §B3): final sweep of BRUNO-TEST-* events. 98-delete-fixture-event
  already DELETEs the per-run BATbern{N} fixture event explicitly; this hook
  is the safety net for any future BRUNO-TEST-* prefix-normalized events
  (see plan §"Risks to track" — eventCode is server-generated today).
}
