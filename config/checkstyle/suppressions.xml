<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <!-- Suppress all checks for generated code -->
    <suppress files="[\\/]generated[\\/]" checks=".*"/>
    <suppress files="[\\/]build[\\/]" checks=".*"/>

    <!-- Relax some checks for test files -->
    <suppress files="Test\.java$" checks="MagicNumber"/>
    <suppress files="Test\.java$" checks="MethodLength"/>
    <suppress files="Test\.java$" checks="LineLength"/>

    <!-- Allow longer parameter lists in configuration classes -->
    <suppress files="Config\.java$" checks="ParameterNumber"/>

    <!-- Pre-existing code: comprehensive query params required for speaker filtering -->
    <suppress files="SpeakerController\.java$" checks="ParameterNumber"/>
    <suppress files="SpeakerContentSubmissionService\.java$" checks="ParameterNumber"/>

    <!-- defaultZone allow-list (coding-standards.md, "Time zones"). The Watch pairing keeps
         zone-less LocalDateTime columns written with LocalDateTime.now() and read back as instants
         with ZoneId.systemDefault(): expiry durations, consistent in any JVM zone, and CUMS sets
         hibernate.jdbc.time_zone=UTC, which converts LocalDateTime values relative to the JVM
         zone. Moving them to explicit UTC belongs with a move to Instant columns, not here. -->
    <suppress id="defaultZone"
              files="companyuser[\\/](domain[\\/]WatchPairing|watch[\\/]WatchPairing(Service|CleanupService|IntegrationTest))\.java$"/>

    <!-- Lombok generates code that may violate some rules -->
    <suppress checks="HiddenField" files=".*\.java"/>
</suppressions>
