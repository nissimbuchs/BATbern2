{
  "_comment": "EMS module naming rules: read by ems-module-deps.py, ems-module-target.py (via ems_modules.py) and the EMS ArchUnit rules (EmsModuleNames). rules: first match wins, on the top-level class name; packages are prefixes of the first package below ch.batbern.events. overrides: by simple name, after the rules. target: regexes (full match) of ems-module-target.py, in order, a later match wins. renames: applied last. examples: '<firstPackage>/<SimpleName>' -> final module, asserted by test_ems_modules.py and EmsModuleNamesSharedRulesTest.",
  "rules": [
    {"module": "watch", "packages": ["watch"], "startsWith": [], "contains": ["LiveTiming", "Watch"]},
    {"module": "usermerge", "packages": ["usermerge"], "startsWith": [], "contains": ["UserMerge", "MergeRequest"]},
    {"module": "notification", "packages": ["notification"], "startsWith": ["Notification"], "contains": ["InAppNotification"]},
    {"module": "tasks", "packages": [], "startsWith": [], "contains": ["Task"]},
    {"module": "analytics", "packages": [], "startsWith": [], "contains": ["Analytics", "Attendance"]},
    {"module": "speakers", "packages": [], "startsWith": [], "contains": ["Speaker", "Outreach", "Invitation", "ContentSubmission", "SelfNomination", "SessionProposal", "QualityReview"]},
    {"module": "registrations", "packages": [], "startsWith": [], "contains": ["Registration", "Registrant", "Deregistration", "Participant", "Waitlist", "Badge", "Attendee", "Enroll", "Stakeholder", "DistributionList"]},
    {"module": "sessions", "packages": [], "startsWith": [], "contains": ["Session", "Slot", "Timetable", "Agenda", "Qna", "QnA", "Timing", "Material"]},
    {"module": "topics_ai", "packages": [], "startsWith": [], "contains": ["Topic", "Ai", "AI", "Prompt", "Similarity", "Cluster", "OpenAi"]},
    {"module": "media", "packages": [], "startsWith": [], "contains": ["Photo", "Teaser", "Image"]},
    {"module": "mail", "packages": ["mailcenter", "forwarding"], "startsWith": [], "contains": ["Newsletter", "Email", "Mail", "SlidesOnline", "Notice", "Venue", "Inbound", "Bounce", "Unsubscribe", "Subscriber", "Ses", "Conversation"]},
    {"module": "event_core", "packages": [], "startsWith": [], "contains": ["Event", "Workflow", "Publish", "Thanks", "Setting", "Admin", "Presentation", "Feature"]}
  ],
  "overrides": {
    "CalendarDeclineService": "mail",
    "CalendarInviteUid": "mail",
    "ConflictDetectionService": "sessions",
    "ConflictSeverity": "sessions",
    "ConflictType": "sessions",
    "SchedulingConflict": "sessions",
    "AssignmentStrategy": "sessions",
    "PreferenceMatchingAlgorithm": "sessions",
    "ContentStatusDeriver": "speakers",
    "InvalidPromotionStateException": "speakers",
    "ReadyRequiresPromoteException": "speakers",
    "AlreadyRespondedException": "speakers",
    "TransitionPayload": "speakers",
    "TransitionResult": "speakers",
    "StalenessScoreService": "speakers",
    "ReminderProperties": "speakers",
    "ConfirmationTokenService": "registrations",
    "OrganizerNotificationService": "notification",
    "DefaultOrganizerNotificationService": "notification",
    "ArchivalBestEffortSteps": "event_core",
    "GenericLogoService": "media",
    "Logo": "media",
    "LogoRepository": "media",
    "LogoStatus": "media",
    "TopicSessionDataService": "topics_ai",
    "TopicSessionDataController": "topics_ai"
  },
  "target": [
    {"module": "publishing", "patterns": ["Publish.*", "Publishing.*", "PublicEvent.*", "PublicSession.*", "SpeakersPhasePublishedEvent"]},
    {"module": "planning", "patterns": ["SlotAssignment.*", "ConflictDetection.*", "PreferenceMatching.*", "SchedulingConflict", "Conflict(Severity|Type)", "AssignmentStrategy", "SessionTiming.*", "SpeakerSlotPreference.*"]},
    {"module": "ai", "patterns": ["Ai.*", "AI.*", "OpenAi.*", ".*Prompt.*"]},
    {"module": "topics_ai", "patterns": ["StalenessScoreService"]},
    {"module": "sessions", "patterns": ["SpeakerAssignmentNotFoundException"]},
    {"module": "registrations", "patterns": ["AttendanceSummaryProjection"]},
    {"module": "mail_core", "patterns": ["MailPipeline", "MailVariables?", "MailContent", "RenderedMail", "Rendering", "DeliveredMail", "SkippedRecipient", "Recipients", "EmailService", "EmailTemplate.*", "AlreadySentException", "UnknownPlaceholderException", "ModeratorReplyAddress", "AudienceAdapter", "Compose(Context|Recipient|Request)", "MailDeliveryStatusService"]},
    {"module": "notif_core", "patterns": ["Notification", "NotificationService", "NotificationRequest", "NotificationRepository", "NotificationController"]}
  ],
  "renames": {
    "mail": "mail_center",
    "notification": "org_notify"
  },
  "examples": {
    "service/EventReadService": "event_core",
    "security/CallerRoles": "platform",
    "service/SessionEventExpansion": "sessions",
    "service/RegistrationEventAdapter": "registrations",
    "service/TeaserImageEventExpansion": "media",
    "service/TopicEventExpansion": "topics_ai",
    "service/SpeakerMetricsExpansion": "speakers",
    "service/EventAnalyticsService": "analytics",
    "publishing/PublicEventShaper": "publishing",
    "service/MailPipeline": "mail_core",
    "mailcenter/ConversationService": "mail_center",
    "notification/NotificationRepository": "notif_core",
    "service/AiDescriptionService": "ai"
  }
}
