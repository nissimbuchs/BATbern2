<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="applicationName" source="spring.application.name"/>
    <springProperty scope="context" name="environment" source="spring.profiles.active"/>

    <!-- Console appender with JSON format -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdc>true</includeMdc>
            <includeContext>true</includeContext>
            <customFields>{"application":"${applicationName}","environment":"${environment}"}</customFields>
        </encoder>
    </appender>

    <!-- #990: there was a second appender here, ca.pjer.logback.AwsLogsAppender, writing
         PatternLayout text DIRECTLY to /aws/ecs/BATbern-${environment}/${applicationName} via
         the AWS SDK — the SAME log group the ECS awslogs driver already delivers stdout to.
         Every event was therefore ingested TWICE: once as LogstashEncoder JSON through CONSOLE
         and the awslogs driver, once as plain text through the SDK.

         Verified before removing, not assumed: the api-gateway task definition
         (BATbernstagingApiGatewayServiceTaskDef8F405B93:266) has
         logConfiguration.logDriver = "awslogs" with awslogs-group
         /aws/ecs/BATbern-staging/api-gateway, so the CONSOLE path alone delivers everything.
         Both renderings of the same event, sharing a correlationId, were observable in that
         group while both appenders were live.

         Cost of the duplicate: 2x CloudWatch Logs ingestion and storage on every request, plus
         an AsyncAppender thread and an AWS SDK client per task, plus logs:PutLogEvents IAM
         surface the driver already covers.

         It also forced the metric filters in AlbAlarms (#986) to carry an extra "@timestamp"
         literal term purely to match one rendering and not the other. That term still works and
         stays: only the JSON rendering has @timestamp, and requiring it is now merely redundant
         rather than load-bearing. Do NOT drop it in the same change as this — one deploy
         between, so the filters are never briefly matching nothing. -->

    <!-- Root logger. CONSOLE only — the ECS awslogs driver ships stdout to CloudWatch. -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- #990: this was DEBUG, in production, doubled by the appender removed above. Every
         request emitted several lines of filter-chain internals (SecurityHeadersFilter,
         RateLimitingFilter). For scale: a single 24h Insights query over this one log group
         scanned 295,644 records.

         Those DEBUG lines were, by accident, the only record of what any request had asked for
         — there was no access log anywhere — and they are what made the #986 scanner
         attribution possible at all. That accident is no longer needed:
         ClientErrorMetricsFilter now emits a proper GATEWAY_API_REQUEST access line at INFO
         with method, path and status. Turning this down loses noise, not evidence.

         Override per-environment with LOGGING_LEVEL_CH_BATBERN=DEBUG when debugging; do not
         re-pin DEBUG here. -->
    <logger name="ch.batbern" level="${LOGGING_LEVEL_CH_BATBERN:-INFO}"/>

    <!-- Spring Framework -->
    <logger name="org.springframework" level="INFO"/>

    <!-- Reduce noise from other frameworks -->
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.apache" level="WARN"/>
</configuration>
